<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@color/midnight_black">

    <!-- 1. Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ComicOCR Service"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/cyber_violet_muted"
            android:background="@drawable/bg_chip_purple"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adreno 830 | 一加 13"
            android:textColor="@color/status_amber"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- 2. Decoupled Server Status Banner (Health & Beacon) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/midnight_card"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/midnight_card_stroke"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <!-- Beacon Ring + Core (Breathing Light) -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/view_beacon_ring"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/dot_green_ring" />

                <View
                    android:id="@+id/view_beacon_core"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:background="@drawable/dot_green" />

            </FrameLayout>

            <!-- Status Titles & Endpoints -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE (存活运行中)"
                    android:textColor="@color/status_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/text_status_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="http://127.0.0.1:8080 (回环)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Port Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/text_port_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":8080 OK"
                    android:textColor="@color/status_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_chip_purple"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

                <TextView
                    android:id="@+id/text_pna_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNA 放行中"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Decoupled Shorter Centered Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_service"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="200dp"
        android:layout_gravity="center_horizontal"
        android:text="⏹  STOP SERVICE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="#FFFFFF"
        app:cornerRadius="22dp"
        app:backgroundTint="@color/status_red_dark"
        android:layout_marginBottom="10dp" />

    <!-- 4. Telemetry Metric Grid (4 Cards: Latency, RAM, Slices, Engine) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- Card 1: Latency -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_telemetry"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 推理耗时 (P50)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/text_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="91 ms"
                android:textColor="@color/status_green"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPU Adreno 830"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Card 2: RAM / VRAM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_telemetry"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💾 显存 / 内存"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/text_memory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="182 MB"
                android:textColor="@color/cyber_violet_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FP16 紧凑低功耗"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- Card 3: Accumulated Slices -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_telemetry"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📑 累计切片处理"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/text_slices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 片"
                android:textColor="@color/status_blue"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="识别成功率 100%"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Card 4: Engine Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_telemetry"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 芯片算力引擎"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/text_engine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vulkan ncnn"
                android:textColor="@color/status_amber"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SM8750 硬件加速"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- 5. Large Monospace Terminal Window (layout_weight="1" for ~60% height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_terminal_box">

        <!-- Terminal Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/midnight_terminal_bar">

            <!-- 3 Dots -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_red"
                android:layout_marginEnd="5dp" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_red"
                android:backgroundTint="@color/status_amber"
                android:layout_marginEnd="5dp" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_green"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TERMINAL LOGS"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/text_terminal_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="@color/status_green"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginStart="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_clear_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清屏"
                android:textColor="@color/cyber_violet_muted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_chip_purple"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- Terminal Log Scroll Stream -->
        <ScrollView
            android:id="@+id/scroll_logs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/text_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready for requests...\n"
                android:textColor="@color/text_terminal"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true" />

        </ScrollView>

        <!-- Terminal Bottom Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@color/midnight_terminal_bar">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/text_socket_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ktor Socket: Active (Port 8080)"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <!-- Battery Optimization Link -->
            <TextView
                android:id="@+id/btn_battery_opt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 保活白名单"
                android:textColor="@color/cyber_violet_light"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
