{
  "manifest_version": 3,
  "name": "ComicTranslate 漫画切片与智能汉化插件",
  "version": "1.0.0",
  "description": "长漫阅读器汉化插件：支持气泡紧致防溢出贴合、彻底消除补丁纵向超长、多通道物理材质分流、闭包Shadow DOM全方位护眼；新增设置页【调试与优化】面板、单次Dev看板、切线辅助线开关与双击全量导出Dev诊断报告。",
  "permissions": ["activeTab", "storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:*/*", "http://127.0.0.1:8080/*", "http://localhost:*/*"],
  "action": {
    "default_title": "漫画页面识别",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "store.js", "classifier.js", "slicing/virtual-strip.js", "slicing/slice-algorithm.js", "slicing/pixel-provider.js", "slicing/slice-pipeline.js", "slicing/capture-flow.js", "debug-hud.js", "capture.js", "floating-ball.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "image_cors", "enabled": true, "path": "rules.json" }]
  }
}
